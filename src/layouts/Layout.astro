---
import '../styles/global.css';
import { getMeta, getSeasons, url } from '../lib/data.ts';

interface Props {
  title?: string;
  description?: string;
  season?: number;
}

const { title, description = 'Live rain radar, forecasts and wet-race history for every Formula 1 Grand Prix.', season } = Astro.props;
const seasons = [...getSeasons()].reverse();
const meta = getMeta();
const fullTitle = title ? `${title} · F1 Rain Radar` : 'F1 Rain Radar';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0f13" />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a class="logo" href={url()}>
          <span class="logo-drop" aria-hidden="true"></span>
          F1 Rain Radar
        </a>
        <nav class="controls" aria-label="Site">
          <label class="season-switch">
            <span class="visually-hidden">Season</span>
            <select data-season-select>
              {!season && <option value="" selected>Season</option>}
              {seasons.map((s) => <option value={url(`${s}/`)} selected={s === season}>{s}</option>)}
            </select>
          </label>
          <button type="button" data-tz-toggle>Your time</button>
          <button type="button" data-units-toggle>°C · km/h</button>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          Radar: <a href="https://www.rainviewer.com/" rel="noopener">RainViewer</a> ·
          Schedule &amp; standings: <a href="https://github.com/jolpica/jolpica-f1" rel="noopener">Jolpica F1</a> ·
          Session data: <a href="https://openf1.org/" rel="noopener">OpenF1</a> ·
          Weather: <a href="https://open-meteo.com/" rel="noopener">Open-Meteo</a> (CC BY 4.0) ·
          Circuit outlines: <a href="https://github.com/bacinger/f1-circuits" rel="noopener">bacinger/f1-circuits</a> ·
          Map: © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a> contributors
        </p>
        <p class="muted">
          Unofficial fan project. Not associated with Formula 1, the FIA or Formula One Management.
          F1 and FORMULA 1 are trademarks of Formula One Licensing B.V.
          {meta.lastDailySync && <>{' '}Data updated <time datetime={meta.lastDailySync}>{meta.lastDailySync.slice(0, 10)}</time>.</>}
        </p>
      </div>
    </footer>

    <script>
      import '../scripts/time.ts';
      import '../scripts/units.ts';

      document.querySelector<HTMLSelectElement>('[data-season-select]')?.addEventListener('change', (e) => {
        const value = (e.target as HTMLSelectElement).value;
        if (value) location.href = value;
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: rgb(13 15 19 / 0.9);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
    flex-wrap: wrap;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    font-style: italic;
    letter-spacing: -0.01em;
    text-decoration: none;
    font-size: 1.1rem;
  }

  .logo-drop {
    width: 0.9rem;
    height: 0.9rem;
    background: var(--accent);
    border-radius: 0 50% 50% 50%;
    transform: rotate(45deg);
  }

  .controls {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .controls button,
  .controls select {
    font-size: 0.85rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  main {
    padding-block: 1.5rem 3rem;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding-block: 1.5rem;
    font-size: 0.8rem;
  }

  .site-footer p {
    margin: 0 0 0.5rem;
  }
</style>
