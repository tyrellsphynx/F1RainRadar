---
import { getCircuit, racePath } from '../lib/data.ts';
import type { Race } from '../lib/schemas.ts';
import { raceStatus } from '../lib/weekend.ts';

interface Props {
  races: Race[];
  now: number;
}

const { races, now } = Astro.props;
const points = races.map((race) => {
  const c = getCircuit(race.circuitId);
  return {
    lat: c.lat,
    lon: c.lon,
    round: race.round,
    name: race.raceName,
    href: racePath(race),
    status: raceStatus(race, now),
  };
});
---

<div class="world-map" data-world-map={JSON.stringify(points)} role="img" aria-label="Map of this season's circuits">
</div>

<script>
  function init(el: HTMLElement) {
    const points = JSON.parse(el.dataset.worldMap!) as {
      lat: number;
      lon: number;
      round: number;
      name: string;
      href: string;
      status: 'completed' | 'live' | 'upcoming';
    }[];
    import('../scripts/leaflet.ts').then(({ L, addDarkBasemap }) => {
      const map = L.map(el, { worldCopyJump: true, scrollWheelZoom: false, minZoom: 1 });
      addDarkBasemap(map);
      const bounds = L.latLngBounds([]);
      for (const p of points) {
        const color = p.status === 'completed' ? '#6b7280' : p.status === 'live' ? '#2fd27a' : '#e10600';
        const marker = L.circleMarker([p.lat, p.lon], {
          radius: 6,
          color: '#fff',
          weight: 1.5,
          fillColor: color,
          fillOpacity: 1,
        }).addTo(map);
        marker.bindTooltip(`R${p.round} · ${p.name}`);
        marker.on('click', () => (location.href = p.href));
        bounds.extend([p.lat, p.lon]);
      }
      if (bounds.isValid()) map.fitBounds(bounds, { padding: [20, 20] });
      else map.setView([20, 0], 1);
    });
  }

  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (!entry.isIntersecting) continue;
      observer.unobserve(entry.target);
      init(entry.target as HTMLElement);
    }
  });
  document.querySelectorAll<HTMLElement>('[data-world-map]').forEach((el) => observer.observe(el));
</script>

<style>
  .world-map {
    height: 300px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    overflow: hidden;
  }
</style>
