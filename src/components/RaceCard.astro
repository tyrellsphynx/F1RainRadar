---
import { circuitHistory, getCircuit, racePath, wetVerdict } from '../lib/data.ts';
import { formatDateRange } from '../lib/format.ts';
import type { Race } from '../lib/schemas.ts';
import { raceSession, raceStart, raceStatus } from '../lib/weekend.ts';

interface Props {
  race: Race;
  now: number;
  featured?: boolean;
}

const { race, now, featured = false } = Astro.props;
const circuit = getCircuit(race.circuitId);
const status = raceStatus(race, now);
const first = race.sessions[0]!.start;
const isSprint = race.sessions.some((s) => s.type === 'Sprint');
const verdict = status === 'completed' ? wetVerdict(race) : null;
const history = status !== 'completed' ? circuitHistory(race.circuitId) : null;
---

<a class:list={['race-card', status, { featured }]} href={racePath(race)}>
  <div class="top">
    <span class="round mono">R{String(race.round).padStart(2, '0')}</span>
    {status === 'live' && <span class="badge live">Race weekend</span>}
    {status === 'upcoming' && featured && <span class="badge next">Next</span>}
    {isSprint && <span class="badge">Sprint</span>}
    {
      verdict && (
        <span
          class:list={['badge', verdict.wet ? 'wet' : 'dry']}
          title={`${verdict.source === 'measured' ? 'Measured' : 'Modelled'}: ${verdict.detail}`}
        >
          {verdict.wet ? 'Wet' : 'Dry'}
        </span>
      )
    }
    {status === 'completed' && !verdict && <span class="badge">Completed</span>}
  </div>
  <h3>{race.raceName}</h3>
  <p class="muted place">{circuit.locality}, {circuit.country}</p>
  <p class="dates mono">{formatDateRange(first, raceSession(race).start, circuit.timezone)}</p>
  {
    status !== 'completed' && (
      <p
        class="forecast"
        data-card-forecast
        data-lat={circuit.lat}
        data-lon={circuit.lon}
        data-race-start={raceStart(race)}
        hidden
      />
    )
  }
  {
    history && (
      <p class="muted history" title={`${history.wet} of ${history.total} races at this circuit were wet`}>
        {Math.round(history.share * 100)}% wet in the past
      </p>
    )
  }
</a>

<script>
  import '../scripts/forecast.ts';
</script>

<style>
  .race-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }

  .race-card:hover {
    border-color: var(--muted);
    transform: translateY(-2px);
  }

  .race-card.completed h3,
  .race-card.completed .dates {
    opacity: 0.7;
  }

  .race-card.featured,
  .race-card.live {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent) inset;
  }

  .top {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .round {
    font-weight: 700;
    color: var(--accent);
    margin-right: auto;
  }

  h3 {
    font-size: 1rem;
    margin: 0.25rem 0 0;
  }

  p {
    margin: 0;
    font-size: 0.85rem;
  }

  .forecast {
    color: var(--rain);
    font-weight: 600;
  }

  .forecast[hidden] {
    display: none;
  }

  .history {
    font-size: 0.78rem;
  }
</style>
