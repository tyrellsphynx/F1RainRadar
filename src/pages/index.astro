---
import Calendar from '../components/Calendar.astro';
import OffseasonHero from '../components/OffseasonHero.astro';
import RaceHero from '../components/RaceHero.astro';
import WorldMap from '../components/WorldMap.astro';
import Layout from '../layouts/Layout.astro';
import { getAllRaces, getSchedule, getSeasons, getSiteState, url } from '../lib/data.ts';
import { findRace, weekendEnd } from '../lib/weekend.ts';

const now = Date.now();
const state = getSiteState();
const allRaces = getAllRaces();
const featured = findRace(allRaces, state.featured);

const completed = allRaces.filter((r) => weekendEnd(r) <= now);
const lastCompleted = completed.at(-1) ?? null;

// Show the calendar of the featured race's season; otherwise the latest known season.
const calendarSeason = featured?.season ?? getSeasons().at(-1)!;
const calendar = getSchedule(calendarSeason)?.races ?? [];
---

<Layout>
  {
    state.mode === 'race' && featured ? (
      <RaceHero race={featured} now={now} />
    ) : (
      <OffseasonHero
        completedSeason={lastCompleted?.season ?? null}
        completedRaces={lastCompleted ? (getSchedule(lastCompleted.season)?.races.length ?? 0) : 0}
        next={featured}
      />
    )
  }

  <section class="section">
    <div class="section-title">
      <h2>{calendarSeason} calendar</h2>
      <a class="muted" href={url(`${calendarSeason}/`)}>Season overview →</a>
    </div>
    <Calendar races={calendar} now={now} featured={state.featured} />
  </section>

  <section class="section">
    <h2>Circuits</h2>
    <WorldMap races={calendar} now={now} />
  </section>
</Layout>
